{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "src/index.js"
      ],
      "cwd": "server",
      "port": 8000
    },
    {
      "name": "server-lab",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "lab"
      ],
      "cwd": "server",
      "port": 8000
    },
    {
      "name": "server-lab-8010",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8010",
        "ENABLE_BOT_LAB=1",
        "node",
        "src/index.js"
      ],
      "cwd": "server",
      "port": 8010
    }
  ]
}